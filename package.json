{
  "name": "calamity-front",
  "version": "0.1.0",
  "private": true,
  "repository": { "type": "git", "url": "https://github.com/job159/cs.git" },
  "homepage": "https://job159.github.io/cs/",
  "description": "災厄前線 CALAMITY FRONT - 1-4 player co-op zombie horde FPS for Android (WebView) and browsers",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "assets": "node tools/assets/build-all.mjs",
    "build:web": "node scripts/build-web.mjs",
    "build:apk": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-apk.ps1",
    "build": "npm run build:web && npm run build:apk",
    "serve": "node scripts/serve.mjs",
    "build:site": "npm run build:web && node scripts/build-site.mjs",
    "release": "node scripts/release.mjs",
    "build:anims": "node tools/assets/zombies/anim/fetch.mjs && node tools/assets/zombies/anim/build.mjs && node tools/assets/zombies/anim/check.mjs"
  },
  "devDependencies": {
    "@wasm-audio-decoders/flac": "^0.2.11",
    "@wasm-audio-decoders/ogg-vorbis": "^0.1.20",
    "7z-wasm": "^1.2.0",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "gltf-validator": "^2.0.0-dev.3.10",
    "jpeg-js": "^0.4.4",
    "meshoptimizer": "^1.3.0",
    "mpg123-decoder": "^1.0.3",
    "pngjs": "^7.0.0",
    "qrcode": "^1.5.4",
    "three-bvh-csg": "^0.0.18",
    "wasm-media-encoders": "^0.7.0"
  },
  "dependencies": {
    "three": "^0.186.1",
    "three-mesh-bvh": "^0.9.16"
  }
}
